# ANSIBLE MANAGED BLOCK: fancy PS1 prompt
parse_git_branch() {
  git branch 2>/dev/null | sed -n '/\* /s///p'
}
{% if enable_k8s_prompt %}
parse_k8s_context() {
  local ctx ns
  ctx=$(kubectl config current-context 2>/dev/null) || return
  ns=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
  # GKE context names are gke_<project>_<zone>_<cluster>; show just <cluster>
  ctx="${ctx##gke_*_*_}"
  echo "${ctx}:${ns:-default}"
}
{% endif %}
__ps1_build() {
  local exit_code=$? status_color status_symbol k8s_ctx

  if [ "$exit_code" -eq 0 ]; then
    status_color='\[\e[32m\]'
    status_symbol='✓'
  else
    status_color='\[\e[31m\]'
    status_symbol='✗'
  fi

  PS1="${status_color}${status_symbol}\[\e[0m\] \[\e[32m\]\w\[\e[0m\]"

  if git rev-parse --is-inside-work-tree &>/dev/null; then
    PS1="${PS1} (\[\e[33m\]$(parse_git_branch)\[\e[0m\])"
  fi
{% if enable_k8s_prompt %}
  k8s_ctx=$(parse_k8s_context)
  if [ -n "$k8s_ctx" ]; then
    PS1="${PS1} [\[\e[36m\]${k8s_ctx}\[\e[0m\]]"
  fi
{% endif %}

  PS1="${PS1}\n\$ "
}
PROMPT_COMMAND="__ps1_build${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
