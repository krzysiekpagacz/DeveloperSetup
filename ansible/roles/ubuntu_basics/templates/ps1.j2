# ANSIBLE MANAGED BLOCK: fancy PS1 prompt
parse_git_branch() {
  git branch 2>/dev/null | sed -n '/\* /s///p'
}
{% if enable_k8s_prompt %}
parse_k8s_context() {
  local ctx ns
  ctx=$(kubectl config current-context 2>/dev/null) || return
  ns=$(kubectl config view --minify -o jsonpath='{..namespace}' 2>/dev/null)
  echo "${ctx}:${ns:-default}"
}
{% endif %}
__ps1_capture_exit_status() {
  __ps1_last_exit=$?
}
PROMPT_COMMAND="__ps1_capture_exit_status${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
parse_exit_status() {
  if [ "${__ps1_last_exit:-0}" -eq 0 ]; then
    printf '\[\e[32m\]✓\[\e[0m\]'
  else
    printf '\[\e[31m\]✗\[\e[0m\]'
  fi
}
export PS1='$(parse_exit_status) \[\e[32m\]\w\[\e[0m\]$(if git rev-parse --is-inside-work-tree &>/dev/null; then echo " (\[\e[33m\]$(parse_git_branch)\[\e[0m\])"; fi){% if enable_k8s_prompt %}$(k8s_ctx=$(parse_k8s_context); if [ -n "$k8s_ctx" ]; then echo " [\[\e[36m\]${k8s_ctx}\[\e[0m\]]"; fi){% endif %}\n\$ '
